{
    "name": "yeevy/centris-passerelle",
    "description": "Unofficial PHP client for the Centris® Passerelle FTP feed — parse, sync & reconcile Quebec MLS listings. Not affiliated with or endorsed by Centris or QFREB.",
    "keywords": [
        "yeevy",
        "centris",
        "passerelle",
        "mls",
        "real-estate",
        "quebec",
        "immobilier",
        "ftp"
    ],
    "homepage": "https://github.com/yeevy-ai/centris-passerelle",
    "license": "MIT",
    "authors": [
        {
            "name": "Oleg Hmelevschi",
            "email": "info@digitalunity.ca",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "league/csv": "^9.27",
        "psr/event-dispatcher": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^8.1",
        "laravel/pint": "^1.0",
        "league/flysystem": "^3.0",
        "league/flysystem-memory": "^3.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "ext-zip": "Required to use ZipExtractor for archived drops.",
        "guzzlehttp/guzzle": "A PSR-18 HTTP client for PhotoDownloader (any PSR-18 client works).",
        "league/flysystem": "Required to use FlysystemFeedSource (^3.0).",
        "league/flysystem-ftp": "FTP adapter for fetching the Passerelle drop with FlysystemFeedSource.",
        "league/flysystem-sftp-v3": "SFTP adapter for fetching the Passerelle drop with FlysystemFeedSource."
    },
    "autoload": {
        "psr-4": {
            "Yeevy\\CentrisPasserelle\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yeevy\\CentrisPasserelle\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
